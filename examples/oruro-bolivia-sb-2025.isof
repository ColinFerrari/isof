  "methods": {
    "sb-digestion-microondes-solides-2021": {
      "name": "Microwave digestion of solid matrices (HNO₃-HF-HCl)",
      "type": "digestion",
      "element": "Sb",
      "target_matrices": [
        "Sediments",
        "Rocks",
        "Ores",
        "Soils",
        "Fly ash"
      ],
      "duration": "About 1 h (program) then evaporation",
      "duration_hours": 2,
      "yield_min_pct": 90,
      "yield_max_pct": 110,
      "equipment": {
        "column": null,
        "resin": null,
        "resin_volume_ml": null,
        "reagents": "HNO₃ (3 mL), HF (1 mL), HCl (1 mL)",
        "temperature": "200 °C"
      },
      "steps": [
        {
          "title": "Weighing",
          "detail": "50 mg of sediment or solid material, in a PTFE tube."
        },
        {
          "title": "Microwave program (UltraWAVE)",
          "detail": "Ramp to 200 °C in 25 min, 10 min hold."
        },
        {
          "title": "Evaporation and recovery",
          "detail": "Evaporation at 75 °C max, recovery in 1.5 M HNO₃."
        }
      ],
      "reference": {
        "doi": "10.1039/d0ja00452a",
        "citation": "Ferrari et al. (2021) J. Anal. At. Spectrom. 36, 776-785"
      },
      "notes": "Sediment protocol from Ferrari et al. (2021)."
    },
    "sb-digestion-mes-filtres-2025": {
      "name": "Hot-plate digestion of SPM filters (HNO₃-HF)",
      "type": "digestion",
      "element": "Sb",
      "target_matrices": [
        "Suspended particulate matter"
      ],
      "duration": "24 h at 100 °C then evaporation",
      "duration_hours": 24,
      "yield_min_pct": null,
      "yield_max_pct": null,
      "equipment": {
        "column": null,
        "resin": null,
        "resin_volume_ml": null,
        "reagents": "Concentrated HNO₃ (4 mL), concentrated HF (3 mL)",
        "temperature": "100 °C"
      },
      "steps": [
        {
          "title": "Filter dissolution",
          "detail": "PVDF filters loaded with SPM, in a PTFE vial, 24 h on a hot plate at 100 °C."
        },
        {
          "title": "Evaporation",
          "detail": "Evaporation to dryness."
        },
        {
          "title": "Recovery",
          "detail": "Recovery in 30 mL of 1.5 M HNO₃."
        }
      ],
      "reference": {
        "doi": "10.1007/s11270-025-08445-6",
        "citation": "Ferrari et al. (2025) Water Air Soil Pollut 236:790"
      },
      "notes": "Digestion specific to SPM filters."
    },
    "sb-purification-tsp-2021": {
      "name": "Single-step Sb purification on thiol mesoporous silica (TSP)",
      "type": "purification",
      "element": "Sb",
      "target_matrices": [
        "Waters",
        "Sediments",
        "Suspended particulate matter"
      ],
      "duration": "About half a day",
      "duration_hours": 5,
      "yield_min_pct": 93,
      "yield_max_pct": 107,
      "equipment": {
        "column": "SPE cartridge 1 mL (Supelco)",
        "resin": "Thiol mesoporous silica (TSP, Sikémia)",
        "resin_volume_ml": "0.2 g",
        "reagents": "HCl 0.5 / 2.5 / 6 M; KI-ascorbic acid 10% w/v",
        "temperature": "Ambient"
      },
      "steps": [
        {
          "title": "Sb(V) to Sb(III) reduction",
          "detail": "KI-ascorbic acid 0.5% w/v, 3 h."
        },
        {
          "title": "Loading",
          "detail": "100 ng of Sb in 0.5 M HCl + KI/AA."
        },
        {
          "title": "Rinse",
          "detail": "5 mL 0.5 M HCl then 6 mL 2.5 M HCl."
        },
        {
          "title": "Elution",
          "detail": "6 mL 6 M HCl."
        }
      ],
      "reference": {
        "doi": "10.1039/d0ja00452a",
        "citation": "Ferrari et al. (2021) J. Anal. At. Spectrom. 36, 776-785"
      },
      "notes": "Sb recovery 103-107% checked by ICP-MS."
    },
    "sb-analyse-d123sb-hg-mc-icpms-2021": {
      "name": "δ123Sb measurement by HG-MC-ICP-MS",
      "type": "analysis",
      "element": "Sb",
      "target_matrices": [
        "Waters",
        "Sediments",
        "Suspended particulate matter"
      ],
      "duration": "About 7 min per measurement",
      "duration_hours": null,
      "yield_min_pct": null,
      "yield_max_pct": null,
      "equipment": {
        "column": null,
        "resin": null,
        "resin_volume_ml": null,
        "reagents": "NaBH₄ 1% w/v in NaOH 0.05% w/v; HCl 3 M; KI/AA 0.5% w/v",
        "temperature": "Ambient"
      },
      "steps": [
        {
          "title": "Preparation",
          "detail": "Dilution to 2 µg/L Sb in 3 M HCl + KI/AA, at least 3 h before analysis."
        },
        {
          "title": "Hydride generation",
          "detail": "HydrideICP module (Elemental Scientific), pump 20 rpm, sample gas flow 0.95 L/min."
        },
        {
          "title": "Acquisition",
          "detail": "Neptune (Thermo), 1080 W, skimmer X / sample Jet cones; 120Sn, 121Sb, 122Sn, 123Sb, 126Te; uptake 140 s; 1 block of 80 cycles, integration 4.194 s; SPEX standard bracketing, 3 measurements."
        },
        {
          "title": "Calculation",
          "detail": "Deviation from the bracketing standard, in per mil (‰)."
        }
      ],
      "reference": {
        "doi": "10.1039/d0ja00452a",
        "citation": "Ferrari et al. (2021) J. Anal. At. Spectrom. 36, 776-785"
      },
      "notes": "Settings optimized in 2021 (Ferrari et al. 2023); 121Sb sensitivity 0.8 V/ppb (Table S2)."
    },
    "sb-dosage-icpms-2021": {
      "name": "Sb, Fe and S quantification by ICP-MS",
      "type": "analysis",
      "element": "Sb",
      "target_matrices": [
        "Waters",
        "Sediments",
        "Suspended particulate matter"
      ],
      "duration": "Analytical routine",
      "duration_hours": null,
      "yield_min_pct": null,
      "yield_max_pct": null,
      "equipment": {
        "column": null,
        "resin": null,
        "resin_volume_ml": null,
        "reagents": "0.15 M HNO₃; He gas (KED)",
        "temperature": "Ambient"
      },
      "steps": [
        {
          "title": "Preparation",
          "detail": "Dilution in 0.15 M HNO₃."
        },
        {
          "title": "Measurement",
          "detail": "ICP-MS (iCAP-TQ), KED mode; QC with CRMs (SLRS-6, PACS-3, GSD-3)."
        }
      ],
      "reference": {
        "doi": "10.1007/s11270-025-08445-6",
        "citation": "Ferrari et al. (2025) Water Air Soil Pollut 236:790"
      },
      "notes": "Sb, Fe and S; Fe and S are AMD contamination markers. Sb(III)/Sb(V) speciation by HPLC-ICP-MS."
    }
  },
